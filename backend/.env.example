# ---------------------------------------------------------------------------
# VoiceGuard AI - backend environment template
# Copy to backend/.env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver).
# Project-local cluster created by scripts/setup_database.ps1:
DATABASE_URL=postgresql+psycopg://voiceguard:voiceguard@127.0.0.1:5433/voiceguard
# Your own PostgreSQL 18 service instead:
# DATABASE_URL=postgresql+psycopg://voiceguard:voiceguard@127.0.0.1:5432/voiceguard

# Leave empty to auto-generate a random key stored in storage/.jwt_secret.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage + upload limits (4 GB RAM friendly defaults)
STORAGE_DIR=../storage
MAX_UPLOAD_MB=20
MIN_AUDIO_SECONDS=1
MAX_AUDIO_SECONDS=60

# AI model (CPU inference)
MODEL_ID=Vansh180/deepfake-audio-wav2vec2
MODEL_CACHE_DIR=../.cache/huggingface
MODEL_SAMPLE_RATE=16000
MODEL_WINDOW_SECONDS=4
MODEL_MAX_WINDOWS=3
MODEL_THREADS=0
MODEL_OFFLINE=0
SYNTHETIC_THRESHOLD=0.5

# Rate limits: requests/seconds
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_ANALYSIS=20/60
